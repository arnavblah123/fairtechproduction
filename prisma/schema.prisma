generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection — on Neon use the POOLED string (-pooler host).
  url       = env("DATABASE_URL")
  // Migrations/seed connection — on Neon use the DIRECT string (no -pooler).
  // Locally, set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth & access ----------

enum Role {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  HR // access to the Labour page (wages / ESI-PF) only
  PURCHASE_HR // Labour app + issues (what's needed) + planning, nothing else
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  monthlySalary Float? // ₹ per month — owner-only; ÷30 = daily overhead spread over the unit's running jobs
  units        UserUnit[] // units this user is scoped to (ignored for SUPERADMIN: sees all)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobsCreated    Job[]      @relation("JobCreatedBy")
  issuesRaised   Issue[]    @relation("IssueRaisedBy")
  issuesResolved Issue[]    @relation("IssueResolvedBy")
  timeLogsStarted TimeLog[] @relation("TimeLogStartedBy")
  timeLogsEnded   TimeLog[] @relation("TimeLogEndedBy")
  auditLogs      AuditLog[]
  attachments    JobAttachment[] @relation("AttachmentUploadedBy")
  reworks        StageRework[]   @relation("ReworkRaisedBy")
  disciplines    Discipline[]    @relation("DisciplineRaisedBy")
  complaintsRaised LabourComplaint[] @relation("ComplaintRaisedBy")
  leavesMarked     LeavePeriod[]     @relation("LeaveMarkedBy")
  cranesStarted  CraneLog[]      @relation("CraneStartedBy")
  cranesEnded    CraneLog[]      @relation("CraneEndedBy")
  plansCreated   Plan[]          @relation("PlanCreatedBy")
  futureJobsAdded FutureJob[]    @relation("FutureJobAddedBy")
  supervisorDays SupervisorDay[]
  todosCreated   TodoItem[]      @relation("TodoCreatedBy")
}

// One record per supervisor/admin per day: "I'm working at unit X today."
// Punched from the dashboard each morning. Drives salary overheads: a
// punched day costs monthlySalary/30, split across the unit's jobs that
// had work logged that day.
model SupervisorDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  date      DateTime @db.Date // IST calendar date
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([unitId, date])
}

enum OverheadPeriod {
  MONTHLY
  ANNUAL
}

// Fixed overheads — rent, electricity, maintenance, insurance, flat
// salaries. Owner-only. Daily cost is amount/30 for monthly items and
// amount/360 for annual ones (12 × 30, so both conventions match), charged
// between effectiveFrom and endedAt and split equally across the jobs that
// had work logged that day (within its unit, or across all units when
// unitId is null).
model OverheadItem {
  id            String    @id @default(cuid())
  name          String
  monthlyAmount Float // ₹ per period (month or year — see `period`)
  period        OverheadPeriod @default(MONTHLY)
  // Which units this cost applies to (any subset). No rows = all units.
  // Spread over the pooled jobs of the selected units each day.
  units         OverheadItemUnit[]
  effectiveFrom DateTime  @db.Date
  endedAt       DateTime? @db.Date // stopped from this day on; history keeps its cost
  createdAt     DateTime  @default(now())
}

// Owner-added to-do items for the supervisors' morning list — reminders,
// dispatch problems, anything. Unit-scoped or general; ticked done by name.
model TodoItem {
  id          String    @id @default(cuid())
  message     String
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id])
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("TodoCreatedBy", fields: [createdById], references: [id])
  done        Boolean   @default(false)
  doneBy      String? // name of who ticked it
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  // The morning list reads open items on every dashboard load.
  @@index([done, unitId])
  @@index([jobId, done])
}

model OverheadItemUnit {
  itemId String
  item   OverheadItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId String
  unit   Unit         @relation(fields: [unitId], references: [id])

  @@id([itemId, unitId])
}

model UserUnit {
  userId String
  unitId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
}

// ---------- Org ----------

model Unit {
  id       String @id @default(cuid())
  name     String @unique
  location String
  code     String @unique // short code e.g. CH1, CH2, SV3

  users     UserUnit[]
  employees Employee[]
  jobs      Job[]
  timeLogs  TimeLog[]
  issues    Issue[]
  transfersIn  UnitTransfer[] @relation("TransferTo")
  transfersOut UnitTransfer[] @relation("TransferFrom")
  disciplines  Discipline[]
  craneLogs    CraneLog[]
  futureJobs   FutureJob[]
  plans        Plan[]
  supervisorDays SupervisorDay[]
  overheadItemUnits OverheadItemUnit[]
  todoItems    TodoItem[]
}

model Employee {
  id            String  @id @default(cuid())
  name          String
  code          String  @unique // employee code
  biometricId   String? @unique // enrollment number (PIN) in the biometric machine
  skill         String // welder, fitter, helper, ...
  contact       String?
  hourlyWage    Float? // ₹ per hour — set and seen by the owner only, drives per-job labour cost
  esiPfMonthly  Float? // ₹ per month ESI/PF lump sum — owner only; ÷30 per worked day, split over the jobs the worker was on that day
  primaryUnitId String
  primaryUnit   Unit    @relation(fields: [primaryUnitId], references: [id])
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transfers   UnitTransfer[]
  timeLogs    TimeLog[]
  disciplines Discipline[]
  leaveDays   LeaveDay[]
  planWorkers StagePlanWorker[]
  complaints  LabourComplaint[]
  leavePeriods LeavePeriod[]
}

// Why a worker isn't in today. Asked on the dashboard the moment someone
// who worked yesterday doesn't show up, so the reason is captured while it
// is still known. Hides the worker from the daily off-list.
enum AbsenceReason {
  INFORMED_LEAVE // asked for leave / known holiday
  LEAVE_WITHOUT_ASKING // simply did not come
  NIGHT_SHIFT_REST // worked the night, resting today
  NOT_PICKING_UP // phone not answered
  OTHER
}

// A long holiday asked for by a worker and recorded by the supervisor.
// Expands into LeaveDay rows for every date in the range, so the daily
// off-list and the labour feed already know he is away.
model LeavePeriod {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  reason      String
  markedById  String
  markedBy    User     @relation("LeaveMarkedBy", fields: [markedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, fromDate])
}

model LeaveDay {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime      @db.Date // IST calendar date
  reason     AbsenceReason @default(INFORMED_LEAVE)
  note       String?
  markedBy   String // name of who ticked it
  createdAt  DateTime      @default(now())

  @@unique([employeeId, date])
}

// Log of unit membership over time. The open row (toDate = null) is the current unit.
model UnitTransfer {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromUnitId String?
  fromUnit   Unit?     @relation("TransferFrom", fields: [fromUnitId], references: [id])
  toUnitId   String
  toUnit     Unit      @relation("TransferTo", fields: [toUnitId], references: [id])
  fromDate   DateTime  @default(now())
  toDate     DateTime?

  @@index([employeeId])
}

// ---------- Process library ----------

model JobTemplate {
  id            String        @id @default(cuid())
  name          String        @unique
  // Job/equipment name this process belongs to (e.g. "Transformer Tank").
  // Typing it in a new job's description auto-selects this template.
  equipmentName String?
  description   String?
  active      Boolean         @default(true)
  stages      TemplateStage[]
  jobs        Job[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TemplateStage {
  id          String      @id @default(cuid())
  templateId  String
  template    JobTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sequence    Int

  @@index([templateId])
}

// ---------- Jobs ----------

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  READY_TO_DISPATCH // supervisor's Final Done: production finished, awaiting dispatch
  COMPLETED
}

model Job {
  id                 String    @id @default(cuid())
  jobNumber          Int       @unique @default(autoincrement())
  clientName         String
  buyerName          String?
  poNumber           String?
  description        String // equipment type / description
  unitId             String
  unit               Unit      @relation(fields: [unitId], references: [id])
  expectedCompletion DateTime
  reminderDaysBefore Int       @default(7)
  status             JobStatus @default(NOT_STARTED)
  priority           Boolean   @default(false)
  priorityRank       Int       @default(100) // order in the Upcoming queue; lower = start first
  completedAt        DateTime? // set when status moves to COMPLETED, cleared if reopened
  estimatedDispatchAt DateTime? // given by the supervisor at Final Done
  googleEventId      String? // Google Calendar event backing the deadline reminder
  templateId         String?
  template           JobTemplate? @relation(fields: [templateId], references: [id])
  createdById        String
  createdBy          User      @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Asked at creation: is all material available? "No" also auto-raises a
  // MATERIAL_SHORTAGE issue with what's needed and by when.
  materialReady Boolean @default(true)
  // PO value without GST, entered by the supervisor at Dispatched ✓ —
  // the owner's cost email compares it against the job's total cost.
  poValue Float?
  // The customer has not issued the PO yet. Stops the daily "add the PO"
  // reminder, but the job is still chased once the expected date passes.
  poAwaited     Boolean   @default(false)
  poAwaitedAt   DateTime? // when it was marked awaited, to age the wait
  poExpectedBy  DateTime? // when the customer said the PO would come
  // Finished weight of the fabricated job in kg, asked at creation. Drives
  // per-kg budgeting: cost, hours and consumables per kg of steel out.
  finishedWeightKg Float?
  // Set when a supervisor reused a previous job's drawing but said the
  // drawing may have changed: work must not proceed on the wrong drawing.
  drawingPending Boolean @default(false)

  stages      Stage[]
  timeLogs    TimeLog[]
  issues      Issue[]
  complaints  LabourComplaint[]
  findings    DailyFinding[]
  attachments JobAttachment[]
  reworks     StageRework[]
  tests       JobTest[]
  planItems   PlanItem[]
  craneLogs   CraneLog[]
  todoItems   TodoItem[]

  @@index([unitId, status])
}

// Drawings / bill of material / other documents attached to a job. Stored in
// Postgres so the app stays a single deployable with no file-storage service.
enum AttachmentKind {
  DRAWING
  BOM
  OTHER
}

model JobAttachment {
  // When this drawing was reused from an earlier job, which one it came from.
  sourceJobId String?
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User           @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([jobId])
  @@index([kind])
}

enum StageStatus {
  PENDING
  ACTIVE
  PAUSED
  REWORK // rework in progress — the latest StageRework reason says what
  DONE
}

model Stage {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sequence    Int
  status      StageStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  // Task due date, set when starting the stage. Write-once for supervisors;
  // only admins can change it after it's entered.
  dueAt       DateTime?
  // Quality check: who inspected the stage when it was marked Done.
  inspectedBy String?
  inspectedAt DateTime?
  // Manufacturing road map (FTE/PRD/RM): the planned bar for this activity.
  // The actual bar is drawn from the days work was really logged.
  plannedStart DateTime?
  plannedEnd   DateTime?
  roadmapNote  String? // short cell note, e.g. "NA"

  timeLogs    TimeLog[]
  reworks     StageRework[]
  tests       JobTest[]
  planItems   PlanItem[]
  planWorkers StagePlanWorker[]

  @@index([jobId])
}

// Labour planning on the road map: who is supposed to work on this activity.
model StagePlanWorker {
  id         String   @id @default(cuid())
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([stageId, employeeId])
  @@index([employeeId])
}

// Testing requirement on a job (DP / RT / Hydro / Kerosene-Leak / UT / …),
// optionally tied to the stage after which it must happen. stageId null =
// final/overall test.
model JobTest {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  name      String
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([stageId])
}

// Rework recorded against a stage — the reason is mandatory. Recording
// rework on a Done stage reopens it.
model StageRework {
  id         String   @id @default(cuid())
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason     String
  raisedById String
  raisedBy   User     @relation("ReworkRaisedBy", fields: [raisedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([stageId])
  @@index([jobId])
}

// ---------- Time tracking (the audit trail that powers the dashboard) ----------

enum LogSource {
  MANUAL // supervisor action in the app
  AUTO_ATTENDANCE // attendance system login/logout event
  AUTO_SHIFT_END // night-plan cutoff (10 PM / 2:30 AM) closed the clock
}

// What the worker is engaged in: production stage work, or general duties
// (material handling / dispatch) that aren't tied to a job stage.
enum WorkActivity {
  STAGE
  MATERIAL_HANDLING
  DISPATCH
  PLATE_CUTTING // plate material cutting
  STRUCTURAL_CUTTING // structural material cutting
}

// Outside crane hire clock — started when a supervisor calls an external
// crane for material handling / dispatch, stopped when it leaves. The hours
// verify the crane vendor's bill.
model CraneLog {
  id          String       @id @default(cuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id])
  purpose     WorkActivity // MATERIAL_HANDLING or DISPATCH
  jobId       String? // which job the crane was called for (null = general)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  note        String?
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  startedById String
  startedBy   User         @relation("CraneStartedBy", fields: [startedById], references: [id])
  endedById   String?
  endedBy     User?        @relation("CraneEndedBy", fields: [endedById], references: [id])

  @@index([unitId, endedAt])
}

model TimeLog {
  id          String     @id @default(cuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id])
  activity    WorkActivity @default(STAGE)
  jobId       String? // null for general duties
  job         Job?       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId     String? // null for general duties
  stage       Stage?     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit       @relation(fields: [unitId], references: [id])
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  // Evening night plan: when set, the clock auto-stops at this time
  // (8:00 PM, 10:00 PM or 2:30 AM IST).
  plannedEndAt DateTime?
  // OT credit: full-night shifts closed at the 2:30 AM cutoff earn +4 hours
  // (240 min) on top of clocked time in all hour/cost totals.
  otBonusMinutes Int @default(0)
  startSource LogSource  @default(MANUAL)
  endSource   LogSource?
  startedById String? // user who assigned, null when auto
  startedBy   User?      @relation("TimeLogStartedBy", fields: [startedById], references: [id])
  endedById   String?
  endedBy     User?      @relation("TimeLogEndedBy", fields: [endedById], references: [id])

  @@index([employeeId, endedAt])
  @@index([stageId, endedAt])
  @@index([jobId])
  // Open clocks per unit (dashboard duty list, overnight to-do check).
  @@index([unitId, endedAt])
  // Date-window scans: reports, history, overhead spreading.
  @@index([startedAt])
}

// ---------- Issues ----------

enum IssueType {
  MATERIAL_SHORTAGE
  LABOUR_SHORTAGE
  OTHER
}

enum IssueStatus {
  OPEN
  RESOLVED
}

model Issue {
  id           String      @id @default(cuid())
  jobId        String
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id])
  type         IssueType
  description  String
  dueAt        DateTime? // by when it must be resolved (sent in the WhatsApp alert)
  status       IssueStatus @default(OPEN)
  raisedById   String
  raisedBy     User        @relation("IssueRaisedBy", fields: [raisedById], references: [id])
  resolvedById String?
  resolvedBy   User?       @relation("IssueResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([unitId, status])
  @@index([jobId, status])
  // The Labour Requests page filters by type.
  @@index([type, status])
}

// ---------- Production planning ----------

// A planning window (any date range). Created by the superadmin;
// supervisors see it read-only.
model Plan {
  id          String     @id @default(cuid())
  name        String
  // Unit this plan is for; null = all units / general.
  unitId      String?
  unit        Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  startDate   DateTime
  endDate     DateTime
  notes       String?
  createdById String
  createdBy   User       @relation("PlanCreatedBy", fields: [createdById], references: [id])
  items       PlanItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// One target inside a plan: "this stage of this job must be done by this
// date". Stage-linked items auto-complete when the stage is marked Done;
// free-text items are ticked manually.
model PlanItem {
  id          String    @id @default(cuid())
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  description String
  targetDate  DateTime // estimated (planned) date
  isDispatch  Boolean   @default(false) // target = the job's dispatch, auto-done when dispatched
  done        Boolean   @default(false)
  doneAt      DateTime? // when manually ticked; stage/dispatch items use real completion times
  // When a target runs late, the supervisor states why. Write-once for
  // supervisors; admins/owner can correct it.
  lateReason   String?
  lateReasonBy String? // name of who entered it
  lateReasonAt DateTime?
  revisedDate  DateTime? // the new expected date given with the late reason
  createdAt   DateTime  @default(now())

  @@index([planId])
}

// Upcoming work not yet created as a job — supervisors add these so the
// 10-day planning can account for them.
model FutureJob {
  id            String    @id @default(cuid())
  clientName    String
  description   String
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  expectedStart DateTime?
  notes         String?
  addedById     String
  addedBy       User      @relation("FutureJobAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime  @default(now())
}

// ---------- Discipline (hour cuts) ----------

enum DisciplineReason {
  DRINKING // 16 hours
  TIMEPASS // 8 hours
  TOBACCO // tobacco / cigarette — 4 hours
  OTHER // custom hours, note required
}

// A delay blamed on a worker: raised from the late-target form, so "who and
// why" is captured the moment the supervisor explains the delay. Kept as a
// complaint record against that worker — no wage cut, unlike Discipline.
model LabourComplaint {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  planItemId String? // the late target this came from
  stageName  String? // what was delayed, in words
  reason     String
  raisedById String
  raisedBy   User      @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  createdAt  DateTime  @default(now())

  @@index([employeeId, createdAt])
  @@index([jobId])
}

model Discipline {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit             @relation(fields: [unitId], references: [id])
  reason     DisciplineReason
  hoursCut   Float
  note       String?
  raisedById String
  raisedBy   User             @relation("DisciplineRaisedBy", fields: [raisedById], references: [id])
  createdAt  DateTime         @default(now())

  @@index([employeeId, createdAt])
  @@index([unitId, createdAt])
}

// ---------- Audit ----------

// Every tool call the assistant or the monitoring agent makes, so there is a
// record of exactly what the AI looked at.
model AiToolCall {
  id        String   @id @default(cuid())
  /// "chat" or "monitor"
  source    String
  runId     String? // groups the calls of one agent run / one chat turn
  userId    String? // who asked (null for the scheduled agent)
  toolName  String
  input     Json
  ok        Boolean  @default(true)
  errorText String?
  ms        Int? // how long the query took
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@map("ai_tool_calls")
}

// What the scheduled monitoring agent found, one row per finding.
model DailyFinding {
  id         String    @id @default(cuid())
  runAt      DateTime  @default(now())
  /// IST calendar day of the run, for grouping
  day        DateTime  @db.Date
  /// "high" | "medium" | "low"
  severity   String    @default("medium")
  title      String
  detail     String
  /// Free-form pointer, e.g. "JOB-0021" or a worker name
  reference  String?
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  acknowledged Boolean @default(false)
  createdAt  DateTime  @default(now())

  @@index([day, severity])
  @@map("daily_findings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String? // null = automatic/system action (e.g. attendance webhook)
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. job.create, stage.assign, timelog.autoClose
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------- Attendance integration (isolated module; raw event inbox) ----------

enum AttendanceEventType {
  LOGIN
  LOGOUT
}

model AttendanceEvent {
  id           String              @id @default(cuid())
  employeeCode String
  eventType    AttendanceEventType
  occurredAt   DateTime
  raw          Json? // raw vendor payload, kept for debugging once real vendor is wired in
  processedAt  DateTime?
  result       String? // human-readable outcome of processing
  createdAt    DateTime            @default(now())

  @@index([employeeCode, occurredAt])
}

// ---------- App settings ----------

model Setting {
  key   String @id
  value String
}

// ---------- Labour calling app ----------

// Activity events pushed from the labour calling app (each phone keeps an
// outbox and syncs when online). clientId makes pushes idempotent.
model LabourActivity {
  id          String   @id @default(cuid())
  clientId    String   @unique
  subjectId   String
  subjectName String
  // Who did it — the logged-in production user whose session pushed this
  // batch (null for key-authenticated external callers).
  actorName   String?
  action      String
  notes       String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([occurredAt])
}

// Latest pipeline counts snapshot from the labour app (single row, id "latest").
model LabourSnapshot {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Shared state of every worker in the labour calling list. The app ships a
// static seed list; this table holds whatever has since changed (status,
// follow-up date, notes, saved/hired) plus any worker added in-app, so all
// callers see one live list instead of a private copy per phone.
model LabourWorkerState {
  seekerId  String   @id
  phone     String?
  data      Json // the full worker record as the app stores it
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([updatedAt])
}
